# Credenciais do TMDB (https://www.themoviedb.org/settings/api)
# Use UMA das duas opções abaixo.

# Opção 1 (recomendada): Token de Leitura da API v4
TMDB_ACCESS_TOKEN=

# Opção 2: Chave da API v3
TMDB_API_KEY=

# Login e listas (Supabase: Project Settings > API)
# Depois de criar o projeto, rode supabase/schema.sql no SQL Editor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
